# =====================================================================
# MediSync Backend Environment Configuration
# College BCA Major Project
# =====================================================================

PORT=5000
NODE_ENV=development

# Authentication Secrets
JWT_SECRET=medisync_super_secret_jwt_key_2026_secure_random_string_change_in_production
JWT_EXPIRES_IN=7d

# Database Configuration (MySQL 8.0+)
# Set DB_CLIENT=mysql to connect to MySQL database
# If DB_CLIENT=auto, MediSync will attempt MySQL connection; if unavailable, it will safely run local persistent SQLite
DB_CLIENT=auto
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=medisync_db

# Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

